    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.11.10",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
